# ===========================================
# WhatsApp-first CRM — Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha os valores

# --- SERVIDOR ---
PORT=3001
NODE_ENV=development

# --- SUPABASE (criar conta em https://supabase.com) ---
# Após criar o projeto, vá em Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# --- GEMINI (produção - free tier) ---
# Gerar em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- MESSAGING PROVIDER ---
# 'evolution-api' (Node.js, padrão) ou 'evolution-go' (Go, alta performance)
MESSAGING_PROVIDER=evolution-api

# --- EVOLUTION API / EVOLUTION GO (local via Docker) ---
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=minha-chave-dev-local

# --- WHATSAPP ---
# Número da secretária virtual (seu número de teste por enquanto)
SECRETARY_PHONE=5548999999999

# --- WEBHOOK (ngrok em dev) ---
# URL pública que a Evolution API vai chamar
WEBHOOK_URL=http://localhost:3001/webhooks/evolution

# --- GATEWAY DE PAGAMENTO (sandbox) ---
# Mercado Pago ou Stripe - modo teste
# MERCADOPAGO_ACCESS_TOKEN=TEST-xxx
# STRIPE_SECRET_KEY=sk_test_xxx
