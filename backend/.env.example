# ===========================================
# Hi Cleo Backend — Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha os valores

# --- SERVIDOR ---
PORT=3001
NODE_ENV=development

# --- SUPABASE ---
# Criar projeto em https://supabase.com → Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- IA ---
# Gemini (obrigatório): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (opcional, fallback): https://console.groq.com
# GROQ_API_KEY=

# --- MESSAGING ---
# Provider: 'evolution-api' ou 'evolution-go'
MESSAGING_PROVIDER=evolution-api
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=

# --- WHATSAPP ---
# Número da secretária virtual (formato: 55DDNNNNNNNNN)
SECRETARY_PHONE=

# --- WEBHOOK ---
# URL pública que a Evolution API chama (usar ngrok em dev)
WEBHOOK_URL=

# --- REDIS (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
QUEUE_MAX_RETRIES=3
QUEUE_BACKOFF_DELAYS=5000,15000,45000

# --- MONITORAMENTO ---
# Seu número para receber alertas do sistema
MONITOR_ADMIN_PHONE=
# Nome da instância principal para monitorar conexão
MONITOR_INSTANCE=secretary

# --- LOGGER ---
LOG_LEVEL=info
LOG_DIR=./logs

# --- CRONS (schedules no formato cron) ---
# Follow-up: verificar leads sem resposta (padrão: a cada hora)
FOLLOWUP_CRON_SCHEDULE=0 * * * *
FOLLOWUP_STALE_HOURS=48
# Contact monitor: verificar threshold de contatos (padrão: a cada 6h)
CONTACT_MONITOR_CRON_SCHEDULE=0 0 * * *
# Cancellation: expirar assinaturas e limpar dados (padrão: meia-noite)
CANCELLATION_CRON_SCHEDULE=0 0 * * *

# --- GATEWAY DE PAGAMENTO (futuro) ---
# Mercado Pago ou Stripe - modo teste
# MERCADOPAGO_ACCESS_TOKEN=TEST-xxx
# STRIPE_SECRET_KEY=sk_test_xxx
