# ===========================================
# Hi Cleo — Variáveis de PRODUÇÃO (VPS)
# ===========================================
# Copie para `.env` NO SERVIDOR e preencha. Nunca commite o `.env` real.
#   cp .env.production.example .env && chmod 600 .env
#
# Regra de ouro: este arquivo é o contrato do servidor. Tudo que é "de dev"
# (localhost, host.docker.internal) NÃO entra aqui.

# --- Aplicação ---
NODE_ENV=production
PORT=3001
# Fuso dos crons e logs (sem isso os agendamentos rodam em UTC e disparam 3h antes)
TZ=America/Sao_Paulo

# --- Banco (app) ---
# DATABASE_URL é montada pelo docker compose de produção a partir destas:
DB_USER=hicleo
DB_PASSWORD=troque-por-senha-forte
DB_NAME=hicleo

# --- Redis (BullMQ) ---
# O compose de produção sobe o Redis com --requirepass; a senha é obrigatória.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=troque-por-senha-forte

# --- URLs públicas ---
# Domínio do site (usado em mensagens, termos e links de convite)
SITE_URL=https://hicleo.com.br
CHECKOUT_URL=https://hicleo.com.br/checkout
# CORS: apenas o(s) domínio(s) reais do site (separados por vírgula, sem barra no fim)
CORS_ORIGIN=https://hicleo.com.br,https://www.hicleo.com.br

# --- Frontend (BUILD-TIME: exige `docker compose build` de novo ao mudar) ---
NEXT_PUBLIC_API_URL=https://api.hicleo.com.br
NEXT_PUBLIC_SITE_URL=https://hicleo.com.br
NEXT_PUBLIC_SECRETARY_PHONE=558597914065
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=

# --- WhatsApp / Evolution API ---
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=troque-por-chave-forte
# URL que a Evolution chama. Em produção pode ser a interna (mesma rede):
#   http://backend:3001/webhooks/evolution  (recomendado — sem passar pelo nginx)
# ou a pública (exige nginx + DNS): https://api.hicleo.com.br/webhooks/evolution
WEBHOOK_URL=http://backend:3001/webhooks/evolution
# Opcional: se preencher, é OBRIGATÓRIO configurar o mesmo valor nos headers da
# instância na Evolution (`POST /webhook/set/<instancia>`), senão TODOS os
# webhooks respondem 401 e a Cleo para de receber mensagens.
EVOLUTION_WEBHOOK_SECRET=
SECRETARY_PHONE=558597914065
MONITOR_INSTANCE=secretary
MONITOR_ADMIN_PHONE=558597914065

# --- Banco da Evolution API ---
EVOLUTION_DB_USER=hicleo
EVOLUTION_DB_PASSWORD=troque-por-senha-forte
EVOLUTION_DB_NAME=hicleo_evolution_db

# --- IA (providers) ---
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=

# --- Mercado Pago (produção) ---
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=

# --- Limites / logs / crons ---
RATE_LIMIT_GLOBAL=200
RATE_LIMIT_PAYMENTS=5
LOG_LEVEL=warn
LOG_DIR=./logs
FOLLOWUP_CRON_SCHEDULE=0 * * * *
FOLLOWUP_STALE_HOURS=48
CONTACT_MONITOR_CRON_SCHEDULE=0 0 * * *
CANCELLATION_CRON_SCHEDULE=0 0 * * *
