# ===========================================
# Hi Cleo — Variáveis de Ambiente (Docker Compose)
# ===========================================
# Copie este arquivo para .env e preencha os valores.
# Este arquivo é usado pelo docker-compose.yml para configurar todos os serviços.

# ===========================
# BACKEND
# ===========================

# --- Servidor ---
PORT=
NODE_ENV=

# --- Database (PostgreSQL) ---
# Connection string no formato: postgresql://user:password@host:port/database
# Docker dev (padrão): postgresql://hicleo:hicleo123@app-db:5432/hicleo
# Docker prod: usar variáveis DB_USER, DB_PASSWORD, DB_NAME
DATABASE_URL=

# --- Database (Produção — usados no docker-compose.prod.yml) ---
# IMPORTANTE: Em produção, usar senhas fortes (32+ chars)
# Gerar com: openssl rand -base64 32
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- IA ---
# Gemini (obrigatório): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (opcional, fallback): https://console.groq.com
# GROQ_API_KEY=
# DeepSeek (provider primário, recomendado): https://platform.deepseek.com
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# Limite diário de chamadas à IA (default: 5000). Protege contra loops ou abuso.
# AI_DAILY_CALL_BUDGET=5000

# --- Messaging ---
# Provider: 'evolution-api' ou 'evolution-go'
MESSAGING_PROVIDER=
# URL interna do Docker (não alterar para uso com compose)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# --- WhatsApp ---
# Número da secretária virtual (formato: 55DDNNNNNNNNN)
SECRETARY_PHONE=

# --- Webhook ---
# URL que a Evolution API chama para notificar o backend
WEBHOOK_URL=
# Secret compartilhado com Evolution API para validar webhooks (opcional)
EVOLUTION_WEBHOOK_SECRET=

# --- Redis (BullMQ) ---
# Hostname interno do Docker (não alterar para uso com compose)
REDIS_HOST=
REDIS_PORT=
# Senha do Redis (OBRIGATÓRIA em produção — gerar com: openssl rand -base64 32)
REDIS_PASSWORD=
QUEUE_MAX_RETRIES=
QUEUE_BACKOFF_DELAYS=

# --- Monitoramento ---
# Seu número para receber alertas do sistema
MONITOR_ADMIN_PHONE=
# Nome da instância principal para monitorar conexão
MONITOR_INSTANCE=

# --- Logger ---
LOG_LEVEL=
LOG_DIR=

# --- Crons ---
FOLLOWUP_CRON_SCHEDULE=
FOLLOWUP_STALE_HOURS=
CONTACT_MONITOR_CRON_SCHEDULE=
CANCELLATION_CRON_SCHEDULE=

# --- Mercado Pago ---
# Obter em: https://www.mercadopago.com.br/developers/panel/app
# Usar credenciais de TESTE (sandbox) durante desenvolvimento
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# --- URLs Públicas ---
CHECKOUT_URL=
# URL base do site (usada em mensagens do WhatsApp)
SITE_URL=

# --- Segurança ---
# Origens permitidas pelo CORS (separar por vírgula)
CORS_ORIGIN=
# Limite global de requisições por minuto por IP (rotas /api/*)
RATE_LIMIT_GLOBAL=
# Limite de criação de pagamentos por minuto por IP
RATE_LIMIT_PAYMENTS=

# --- Sentry (error tracking, opcional) ---
# Criar projeto em https://sentry.io → Settings > DSN
# SENTRY_DSN=

# ===========================
# FRONTEND (build-time)
# ===========================

# URL do backend acessível pelo navegador do usuário
NEXT_PUBLIC_API_URL=
# Chave pública do Mercado Pago (não é secret)
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
# Número da Cleo para exibir na UI
NEXT_PUBLIC_SECRETARY_PHONE=
# URL do site (para meta tags, OG, etc.)
NEXT_PUBLIC_SITE_URL=

# --- Sentry (error tracking, opcional) ---
# DSN do Sentry para o frontend (mesmo projeto ou projeto separado)
# NEXT_PUBLIC_SENTRY_DSN=
# Auth token para upload de source maps (apenas CI/CD)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ===========================
# EVOLUTION API (infraestrutura)
# ===========================

# IMPORTANTE: Em produção, usar senhas fortes (32+ chars)
# Gerar com: openssl rand -base64 32
EVOLUTION_DB_USER=
EVOLUTION_DB_PASSWORD=
EVOLUTION_DB_NAME=

# ==============================================================================
# CONFIGURAÇÃO DE TESTE E2E (QUALIDADE)
# ==============================================================================

# Delay entre mensagens em milissegundos (tempo para fila + rate limiter)
E2E_MESSAGE_DELAY=

# Número de conversas autônomas a serem geradas nos testes
E2E_CONVERSATION_COUNT=

# Máximo de turnos por conversa para evitar loops infinitos
E2E_MAX_TURNS=

# Threshold (nota) mínimo para aprovação do teste (0.0 a 1.0)
E2E_PASS_THRESHOLD=

# Provider para o simulador de persona (Opções: ollama, deepseek, groq, gemini)
E2E_PERSONA_PROVIDER=

# Provider para o judge/evaluator (Opções: ollama, deepseek, groq, gemini)
E2E_JUDGE_PROVIDER=

# Provider legado (usado quando persona e judge compartilham a mesma IA)
E2E_AI_PROVIDER=

# ==============================================================================
# CONFIGURAÇÃO DO OLLAMA (MODELOS LOCAIS)
# ==============================================================================

# URL base onde o serviço do Ollama está rodando localmente
E2E_OLLAMA_BASE_URL=

# Modelo do persona local (qwen3:1.7b recomendado para evitar travamento em CPU)
E2E_OLLAMA_MODEL=

# Temperatura para o persona (mais alta = maior variação e naturalidade)
E2E_OLLAMA_PERSONA_TEMP=

# Temperatura para o judge (mais baixa = respostas mais consistentes e técnicas)
E2E_OLLAMA_JUDGE_TEMP=

# Limite de tokens para as mensagens da persona (mensagens curtas estilo WhatsApp)
E2E_OLLAMA_PERSONA_MAX_TOKENS=

# Limite de tokens para as respostas do avaliador (análises mais longas)
E2E_OLLAMA_JUDGE_MAX_TOKENS=

# Tempo limite de timeout em milissegundos para chamadas locais (120 segundos)
E2E_OLLAMA_TIMEOUT=