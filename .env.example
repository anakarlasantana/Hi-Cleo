# ===========================================
# Hi Cleo — Variáveis de Ambiente (Docker Compose)
# ===========================================
# Copie este arquivo para .env e preencha os valores.
# Este arquivo é usado pelo docker-compose.yml para configurar todos os serviços.

# ===========================
# BACKEND
# ===========================

# --- Servidor ---
PORT=
NODE_ENV=

# --- Supabase ---
# Criar projeto em https://supabase.com → Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- IA ---
# Gemini (obrigatório): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (opcional, fallback): https://console.groq.com
# GROQ_API_KEY=

# --- Messaging ---
# Provider: 'evolution-api' ou 'evolution-go'
MESSAGING_PROVIDER=
# URL interna do Docker (não alterar para uso com compose)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# --- WhatsApp ---
# Número da secretária virtual (formato: 55DDNNNNNNNNN)
SECRETARY_PHONE=

# --- Webhook ---
# URL que a Evolution API chama para notificar o backend
WEBHOOK_URL=
# Secret compartilhado com Evolution API para validar webhooks (opcional)
EVOLUTION_WEBHOOK_SECRET=

# --- Redis (BullMQ) ---
# Hostname interno do Docker (não alterar para uso com compose)
REDIS_HOST=
REDIS_PORT=
QUEUE_MAX_RETRIES=
QUEUE_BACKOFF_DELAYS=

# --- Monitoramento ---
# Seu número para receber alertas do sistema
MONITOR_ADMIN_PHONE=
# Nome da instância principal para monitorar conexão
MONITOR_INSTANCE=

# --- Logger ---
LOG_LEVEL=
LOG_DIR=

# --- Crons ---
FOLLOWUP_CRON_SCHEDULE=
FOLLOWUP_STALE_HOURS=
CONTACT_MONITOR_CRON_SCHEDULE=
CANCELLATION_CRON_SCHEDULE=

# --- Mercado Pago ---
# Obter em: https://www.mercadopago.com.br/developers/panel/app
# Usar credenciais de TESTE (sandbox) durante desenvolvimento
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# --- URLs Públicas ---
CHECKOUT_URL=

# --- Segurança ---
# Origens permitidas pelo CORS (separar por vírgula)
CORS_ORIGIN=
# Limite global de requisições por minuto por IP (rotas /api/*)
RATE_LIMIT_GLOBAL=
# Limite de criação de pagamentos por minuto por IP
RATE_LIMIT_PAYMENTS=

# ===========================
# FRONTEND (build-time)
# ===========================

# URL do backend acessível pelo navegador do usuário
NEXT_PUBLIC_API_URL=
# Chave pública do Mercado Pago (não é secret)
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
# Número da Cleo para exibir na UI
NEXT_PUBLIC_SECRETARY_PHONE=
# URL do site (para meta tags, OG, etc.)
NEXT_PUBLIC_SITE_URL=

# ===========================
# EVOLUTION API (infraestrutura)
# ===========================

EVOLUTION_DB_USER=
EVOLUTION_DB_PASSWORD=
EVOLUTION_DB_NAME=
