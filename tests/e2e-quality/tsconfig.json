{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "typeRoots": ["../../backend/node_modules/@types"],
    "paths": {
      "pg": ["../../backend/node_modules/@types/pg"],
      "*": ["../../backend/node_modules/*"]
    }
  },
  "include": ["**/*.ts"]
}
